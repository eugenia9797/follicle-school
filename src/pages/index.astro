---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import homeHero from '../assets/brand/home-hero.webp';
import doctorBand from '../assets/brand/doctor-band.webp';
import iconAga from '../assets/icon-aga.jpg';
import { CONTACT_LINKS, DOCTOR_NAME, DOCTOR_TITLE, SITE_DESCRIPTION } from '../consts.js';

const booking = CONTACT_LINKS.find((l) => l.id === 'booking');

const areas = [
  {
    href: '/follicle-school/',
    title: '落髮專區',
    latin: '毛囊研究所 Follicle School',
    desc: '雄性禿、休止期落髮、圓禿的成因、分期與治療比較，並提供自我落髮檢測。',
    image: iconAga,
    ready: true,
  },
  { title: '酒糟', desc: '泛紅、灼熱、丘疹膿皰的成因與長期控制。', ready: false },
  { title: '青春痘與痘疤', desc: '從粉刺到痘疤，不同階段的治療選擇。', ready: false },
];
---

<BaseLayout description={SITE_DESCRIPTION}>
  {/* 圖片塊一 */}
  <section class="plate plate--photo">
    <Image src={homeHero} alt="" width={2048} widths={[900, 1440, 2048]} sizes="100vw" loading="eager" />
  </section>

  {/* 文字塊一：原網站的入口引言 */}
  <section class="statement">
    <p class="statement__eyebrow">關於皮膚 ・ About the skin</p>
    <h1 class="statement__title">皮膚是人類最溫柔的器官</h1>
    <p class="statement__text">
      她不會說話，但卻承載著一個人的情緒、個性，與一路走來的故事。<br />
      當皮膚生病了，影響的不只是外表，也會悄悄改變你看待自己的方式。
    </p>
    <p class="statement__text statement__text--strong">
      讓我用皮膚科的專業，陪你重拾健康的皮膚，找回自信。
    </p>
  </section>

  {/* 圖片塊二：醫師照片，文字疊在左半邊的留白上 */}
  <section class="showcase">
    <Image
      class="showcase__img"
      src={doctorBand}
      alt={`${DOCTOR_NAME} ${DOCTOR_TITLE}`}
      width={2400}
      widths={[900, 1440, 2400]}
      sizes="100vw"
      loading="lazy"
    />
    <div class="showcase__inner">
      <div class="showcase__panel">
        <p class="showcase__eyebrow">醫師介紹 ・ The doctor</p>
        <h2 class="showcase__title">{DOCTOR_NAME}　{DOCTOR_TITLE}</h2>
        <p class="showcase__text">
          落髮治療（女性落髮、雄性禿、圓禿等）、青春痘與痘疤、女性私密處相關問題，亦專精於色素斑點雷射、非侵入式電音波與臉部精雕微整等。
        </p>
        <p class="showcase__text showcase__text--slogan">
          讓我陪您重欣出發，找回喜歡自己的樣子。
        </p>
        <div class="showcase__actions">
          <a class="btn" href={booking.href} target="_blank" rel="noopener noreferrer">預約掛號 →</a>
          <a class="btn btn--ghost" href="/about/">認識醫師</a>
        </div>
      </div>
    </div>
  </section>

  {/* 衛教專區：卡片橫向滑動，右上角箭頭控制 */}
  <section class="wrap" style="padding-block:64px 88px;">
    <div class="section-head">
      <div>
        <h2 class="home-section-title">衛教專區</h2>
        <p class="hint">依疾病整理的完整衛教內容，從成因、分期到治療選擇</p>
      </div>
      <div class="carousel-nav" data-carousel-nav>
        <button type="button" data-carousel-prev aria-label="上一組" aria-controls="feature-track">‹</button>
        <button type="button" data-carousel-next aria-label="下一組" aria-controls="feature-track">›</button>
      </div>
    </div>

    <div class="feature-track" id="feature-track" data-carousel tabindex="0" aria-label="衛教主題">
      {
        areas.map((area) =>
          area.ready ? (
            <a class="feature-card" href={area.href}>
              <Image
                src={area.image}
                alt=""
                width={520}
                widths={[280, 520, 780]}
                sizes="(min-width: 1148px) 350px, (min-width: 700px) 45vw, 88vw"
                class="feature-card__img"
                loading="lazy"
              />
              <span class="feature-card__scrim" />
              <span class="feature-card__body">
                <span class="feature-card__title">{area.title}</span>
                {area.latin && <span class="feature-card__latin">{area.latin}</span>}
                <span class="feature-card__desc">{area.desc}</span>
                <span class="feature-card__more">進入專區 →</span>
              </span>
            </a>
          ) : (
            <div class="feature-card feature-card--soon">
              <span class="feature-card__body">
                <span class="feature-card__title">{area.title}</span>
                <span class="feature-card__desc">{area.desc}</span>
                <span class="feature-card__more">內容建置中</span>
              </span>
            </div>
          ),
        )
      }
    </div>
  </section>

</BaseLayout>

<script>
  const track = document.querySelector('[data-carousel]');
  const nav = document.querySelector('[data-carousel-nav]');

  if (track && nav) {
    const prev = nav.querySelector('[data-carousel-prev]');
    const next = nav.querySelector('[data-carousel-next]');

    const step = () => {
      const card = track.querySelector('.feature-card');
      if (!card) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    };

    // The arrows stay in place as the section's affordance; they simply grey
    // out until there are enough topics to scroll through.
    const sync = () => {
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= max - 4;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  }
</script>
