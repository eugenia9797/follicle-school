---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConditionHero from '../../components/ConditionHero.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import StageAccordion from '../../components/StageAccordion.astro';
import Faq from '../../components/Faq.astro';
import PageNotes from '../../components/PageNotes.astro';
import heroRosacea from '../../assets/local/hero-rosacea.webp';
import {
  ROSACEA_FAQ,
  ROSACEA_SELFCARE,
  ROSACEA_TREATMENTS,
  ROSACEA_TRIGGERS,
  ROSACEA_TYPES,
} from '../../data/rosacea.js';
import { CONTACT_LINKS } from '../../consts.js';

const booking = CONTACT_LINKS.find((l) => l.id === 'booking');

const description =
  '玫瑰斑（酒糟，Rosacea）衛教：基因、神經血管與免疫共同造成的慢性泛紅，紅斑血管擴張型、丘疹膿皰型、增生肥厚型與眼部型四種臨床表現，蠕型蟎蟲扮演的角色，以及外用、口服與光電治療的選擇。';
---

<BaseLayout title="玫瑰斑（酒糟）" description={description} current="conditions">
  <ConditionHero
    eyebrow="慢性發炎性皮膚病"
    hook="臉總是紅通通，又熱又刺？"
    promise="玫瑰斑是可以長期控制的！"
    lead="玫瑰斑不是單純的敏感肌，也不是洗不乾淨。它是一種和基因、血管神經與免疫都有關的慢性疾病，找出誘發因子並接受適當治療，就能讓皮膚穩定下來。"
    image={heroRosacea}
    imageAlt="玫瑰斑示意插圖：女性對著鏡子，臉頰泛紅並出現丘疹"
    crumb={{ href: '/conditions/', label: '皮膚疾病', current: '玫瑰斑（酒糟）' }}
    sections={[
      { id: 'mechanism', label: '致病機轉' },
      { id: 'types', label: '臨床分型' },
      { id: 'demodex', label: '蠕型蟎蟲' },
      { id: 'care', label: '日常照護' },
      { id: 'treatments', label: '治療選擇' },
      { id: 'faq', label: '常見問題' },
    ]}
  />

  <section class="wrap" style="padding-block:40px 90px;">
    <h2 class="section-title" style="margin-bottom:12px;" id="mechanism">致病機轉</h2>
    <p class="lede">
      玫瑰斑（酒糟）並非單一原因造成。在具有遺傳體質的皮膚上，外在刺激（高溫、日曬、辛辣飲食、酒精、情緒壓力）會誘發先天免疫過度反應，同時讓血管與神經末梢變得過度敏感。血管反覆擴張、發炎訊號持續累積，就形成了反覆的泛紅、丘疹與灼熱刺痛。
    </p>

    <ul class="trigger-grid">
      {
        ROSACEA_TRIGGERS.map((t) => (
          <li class="trigger-card">
            <span class="trigger-card__label">{t.label}</span>
            <span class="trigger-card__desc">{t.desc}</span>
          </li>
        ))
      }
    </ul>

    <ImageSlot
      id="rosacea-mechanism"
      radius={14}
      alt="玫瑰斑致病機轉示意圖：基因、熱辣情緒、免疫系統與神經血管過度活化共同作用於皮膚"
      placeholder="玫瑰斑致病機轉示意圖（圖片準備中）"
      style="width:100%;aspect-ratio:16/9;margin:18px 0 36px;"
      width={1052}
      widths={[700, 1052, 1400, 2104]}
      sizes="(min-width: 1148px) 1052px, 92vw"
      loading="eager"
    />

    <h2 class="section-title" id="types">臨床分型</h2>
    <p class="hint">點選卡片查看說明。四種表現可能同時存在，也可能隨時間變化。</p>
    <StageAccordion
      stages={ROSACEA_TYPES}
      slotPrefix="rosacea-type-"
      variant="condition"
      chipMin={150}
      placeholder="示意插圖（圖片準備中）"
      imgAspect="4 / 3"
      photos
    />

    <h2 class="section-title" style="margin-top:44px;" id="demodex">蠕型蟎蟲（Demodex）</h2>
    <p class="lede">
      蠕型蟎蟲是人體皮膚上常見的共生蟎蟲，大多數人身上都有，平時並不會造成問題。但研究發現玫瑰斑患者臉部的蟎蟲密度常明顯較高，蟎蟲本身、其排泄物與體內的細菌，都可能進一步刺激免疫系統、加重發炎反應，尤其與丘疹膿皰型的關聯最受討論。
    </p>
    <p class="lede" style="margin-top:14px;">
      是否需要針對蠕型蟎蟲治療，需由醫師依臨床表現判斷；必要時可透過皮膚表面切片等方式評估蟎蟲密度。治療上，外用 ivermectin 等藥物可同時降低蟎蟲密度並抑制發炎。
    </p>

    <div class="demodex-grid">
      <figure class="demodex-figure">
        <ImageSlot
          id="rosacea-demodex-micrograph"
          radius={12}
          alt="顯微鏡下的蠕型蟎蟲"
          placeholder="顯微鏡下蠕型蟎蟲（圖片準備中）"
          style="width:100%;aspect-ratio:4/3;"
          width={520}
          widths={[420, 520, 1040]}
          sizes="(min-width: 760px) 500px, 92vw"
        />
        <figcaption>顯微鏡下的蠕型蟎蟲</figcaption>
      </figure>
      <figure class="demodex-figure">
        <ImageSlot
          id="rosacea-demodex-cartoon"
          radius={12}
          alt="蠕型蟎蟲寄居於毛囊的模擬示意圖"
          placeholder="蠕型蟎蟲模擬示意圖（圖片準備中）"
          style="width:100%;aspect-ratio:4/3;"
          width={520}
          widths={[420, 520, 1040]}
          sizes="(min-width: 760px) 500px, 92vw"
        />
        <figcaption>蠕型蟎蟲寄居於毛囊的模擬示意圖</figcaption>
      </figure>
    </div>

    <h2 class="section-title" style="margin-top:44px;" id="care">日常照護</h2>
    <p class="hint">治療之外，穩定的日常照護是玫瑰斑能不能長期控制的關鍵。</p>
    <ul class="bullets">
      {ROSACEA_SELFCARE.map((item) => <li>{item}</li>)}
    </ul>

    <h2 class="section-title" style="margin-top:44px;" id="treatments">治療選擇</h2>
    <p class="hint">
      實際用藥與療程需由醫師依分型、嚴重度與個人狀況決定，以下僅為衛教說明。
    </p>
    {
      ROSACEA_TREATMENTS.map((group) => (
        <div class="tx-group">
          <h3 class="tx-group__title">{group.group}</h3>
          <ul class="tx-list">
            {group.items.map((item) => (
              <li>
                <span class="tx-list__name">{item.name}</span>
                <span class="tx-list__use">{item.use}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <p class="warn-note" style="margin-top:22px;">
      ⚠ 請勿自行長期使用外用類固醇。短期可能讓泛紅看似改善，長期卻會使皮膚變薄、血管更明顯，停用後出現更嚴重的反彈，甚至造成類固醇引起的玫瑰斑。
    </p>

    <p style="margin-top:30px;">
      <a class="btn" href={booking.href} target="_blank" rel="noopener noreferrer">預約掛號 →</a>
    </p>

    <Faq items={ROSACEA_FAQ} idPrefix="faq-r" />

    <PageNotes
      sources={[
        'Standard classification and pathophysiology of rosacea: The 2017 update by the National Rosacea Society Expert Committee',
        {
          label: 'National Rosacea Society｜Faces of Rosacea',
          href: 'https://www.rosacea.org/patients/faces-of-rosacea',
        },
        '台灣皮膚科醫學會：2023 年玫瑰斑（酒糟）治療共識手冊',
      ]}
      imageNote="本頁人物插圖為示意圖；臨床照片用於說明各分型之疾病表現。"
    />
  </section>
</BaseLayout>

<script>
  // 分型卡片與 FAQ 的展開／收合，與落髮各頁共用同一支
  import '../../scripts/aga.js';
</script>
