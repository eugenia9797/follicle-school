---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import portrait from '../assets/brand/doctor-cutout.webp';
import bookCover from '../assets/brand/book-cosmetic-injection.webp';
import { CONTACT_LINKS, DOCTOR_NAME, DOCTOR_TITLE } from '../consts.js';
import {
  CLINICS,
  CONFERENCES,
  CREDENTIALS,
  HONOURS,
  INTERVIEWS,
  PUBLICATIONS,
  SCHEDULE,
  SCHEDULE_PERIODS,
  SOCIETIES,
  SPECIALTIES,
  TRANSLATIONS,
} from '../data/doctor.js';
import { lqipStyle } from '../lib/lqip.js';

const booking = CONTACT_LINKS.find((l) => l.id === 'booking');
const description = `${DOCTOR_NAME}${DOCTOR_TITLE}：長庚體系皮膚科主治醫師，專長涵蓋落髮治療、青春痘與痘疤、酒糟、色素斑雷射與醫學美容，並於國內外期刊發表多篇皮膚科實證研究。`;
---

<BaseLayout title="醫師介紹" description={description} current="about">
  <section class="wrap" id="profile" style="padding-block:56px 32px;">
    <div class="profile">
      <div class="profile__media">
        <div class="profile__frame">
          <Image
            style={lqipStyle(portrait, "contain")}
            src={portrait}
            alt={`${DOCTOR_NAME} ${DOCTOR_TITLE}`}
            width={520}
            densities={[1, 2]}
            loading="eager"
          />
        </div>
      </div>

      <div class="profile__main">
        <h1 class="profile__name">{DOCTOR_NAME}　{DOCTOR_TITLE}</h1>

        <h2 class="profile__heading">專長</h2>
        <ul class="pill-list">{SPECIALTIES.map((item) => <li>{item}</li>)}</ul>

        <div class="profile__cols">
          <div>
            <h2 class="profile__heading">學經歷</h2>
            <ul class="cv-list cv-list--tight">{CREDENTIALS.map((c) => <li>{c}</li>)}</ul>
          </div>
          <div>
            <h2 class="profile__heading">學會</h2>
            <ul class="cv-list cv-list--tight">{SOCIETIES.map((c) => <li>{c}</li>)}</ul>

            <h2 class="profile__heading" style="margin-top:32px;">特殊榮譽</h2>
            <ul class="cv-list cv-list--tight">{HONOURS.map((c) => <li>{c}</li>)}</ul>
          </div>
        </div>

        <a
          class="btn"
          href={booking.href}
          target="_blank"
          rel="noopener noreferrer"
          style="margin-top:30px;"
        >預約掛號 →</a>
      </div>
    </div>
  </section>

  <section class="wrap" id="clinic" style="padding-block:8px 0;">
    <h2 class="profile__heading">門診資訊</h2>

    <table class="schedule">
      <caption class="visually-hidden">門診時間表</caption>
      <thead>
        <tr>
          <th scope="col"><span class="visually-hidden">時段</span></th>
          {SCHEDULE.map((d) => <th scope="col">{d.day}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          SCHEDULE_PERIODS.map((period) => (
            <tr>
              <th scope="row">
                {period.label}
                <span class="schedule__time">{period.time}</span>
              </th>
              {SCHEDULE.map((d) =>
                d[period.id].length ? (
                  <td>
                    {d[period.id].map((id, i) => (
                      <>
                        {i > 0 && <span class="schedule__or">或</span>}
                        <span class={`schedule__chip schedule__chip--${id}`}>{CLINICS[id].label}</span>
                      </>
                    ))}
                  </td>
                ) : (
                  <td class="schedule__none">
                    <span aria-hidden="true">—</span>
                    <span class="visually-hidden">無門診</span>
                  </td>
                ),
              )}
            </tr>
          ))
        }
      </tbody>
    </table>

    <ul class="schedule-legend">
      {
        Object.entries(CLINICS).map(([id, clinic]) => (
          <li>
            <span class={`schedule__chip schedule__chip--${id}`}>{clinic.label}</span>
            {clinic.name}
          </li>
        ))
      }
    </ul>
    <p class="hint--sm" style="margin-top:12px;">門診時間如有異動，以診所公告為準。</p>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="profile__heading" id="interviews">媒體採訪</h2>
      <ul class="cv-list--links">
        {
          INTERVIEWS.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                {item.title}
              </a>
              <span class="cv-source">{item.source}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="wrap" style="padding-block:52px 24px;">
    <h2 class="profile__heading" id="conferences">研討會發表</h2>
    <div class="profile__cols">
      {
        CONFERENCES.map((group) => (
          <div class="cv-group">
            <h3 class="cv-group__title">{group.scope}</h3>
            <ul class="cv-list cv-list--tight">{group.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="band" style="margin-top:28px;">
    <div class="wrap">
      <h2 class="profile__heading" id="translation">專書翻譯</h2>
      {
        TRANSLATIONS.map((book) => (
          <article class="book">
            <div class="book__cover">
              <Image
                style={lqipStyle(bookCover, 'contain')}
                src={bookCover}
                alt={`《${book.title}》書封`}
                width={200}
                densities={[1, 2]}
                loading="lazy"
              />
              {book.coverCredit && <p class="book__credit">書封圖片來源：{book.coverCredit}</p>}
            </div>
            <div class="book__body">
              <p class="book__role">{book.role}</p>
              <h3 class="book__title">{book.title}</h3>
              <p class="book__english">{book.english}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap" style="padding-block:52px 80px;">
    <h2 class="profile__heading" id="publications">
      期刊論文 <span class="section-title__count">{PUBLICATIONS.length} 篇</span>
    </h2>
    <ol class="cv-list cv-list--refs">{PUBLICATIONS.map((p) => <li>{p}</li>)}</ol>
  </section>
</BaseLayout>
