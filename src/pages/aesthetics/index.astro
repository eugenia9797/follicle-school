---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import logo from '../../assets/brand/logo-esheen.png';

const description = '醫學美容衛教：私密處保養、色素斑雷射、電音波拉提與微整注射等療程的專業觀點。由皮膚專科醫師黃易欣整理。';

// Same card grid as 皮膚疾病. An entry without `image` gets the brand plate
// until an illustration is supplied for it.
const articles = [
  {
    href: '/aesthetics/intimate-care/',
    title: '私密處保養',
    subtitle: '女人最柔軟的秘密',
    desc: '私密處肌膚比身體其他部位更薄、更敏感。從除毛方式的比較、常見困擾的成因，到改善與治療的專業建議。',
  },
];
---

<BaseLayout title="醫學美容" description={description} current="aesthetics">
  <section class="wrap" style="padding-block:56px 24px;">
    <h1 class="page-title" style="margin-bottom:10px;">醫學美容</h1>
    <p class="lede lede--lg">細緻呵護，重拾自信光采。</p>
  </section>

  <section class="wrap" style="padding-bottom:80px;">
    <div class="area-grid area-grid--rich">
      {
        articles.map((a) => (
          <a class="area-card area-card--img" href={a.href}>
            {a.image ? (
              <Image src={a.image} alt={a.title} width={420} densities={[1, 2]} class="area-card__img" />
            ) : (
              <span class="area-card__plate">
                <Image src={logo} alt="" height={70} densities={[1, 2]} />
              </span>
            )}
            <span class="area-card__title">{a.title}</span>
            <span class="area-card__latin">{a.subtitle}</span>
            <span class="area-card__desc">{a.desc}</span>
            <span class="area-card__more">閱讀文章 →</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
