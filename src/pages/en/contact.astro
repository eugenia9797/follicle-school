---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CONTACT_LINKS } from '../../consts.js';

const booking = CONTACT_LINKS.find((l) => l.id === 'booking');
const social = CONTACT_LINKS.filter((l) => l.id !== 'booking');
const description =
  'Get in touch with board-certified dermatologist Dr. I-Hsin Huang: online booking, Instagram, Facebook and the LINE official account.';
---

<BaseLayout title="Contact" description={description} current="contact">
  <section class="wrap wrap--narrow" style="padding-block:56px 80px;">
    <h1 class="page-title">Contact</h1>
    <p class="lede lede--lg" style="margin-bottom:32px;">
      For questions about appointments, booking, or feedback on these guides, you can reach me in any of the ways below. If you have sudden or severe symptoms, please go straight to a clinic or emergency department.
    </p>

    <div class="contact-grid">
      <a class="contact-card contact-card--primary" href={booking.href} target="_blank" rel="noopener noreferrer">
        <span class="contact-card__label">Book online</span>
        <span class="contact-card__desc">See available times and book directly</span>
      </a>
      {
        social.map((link) => (
          <a class="contact-card" href={link.href} target="_blank" rel="noopener noreferrer">
            <span class="contact-card__label">{link.label}</span>
            <span class="contact-card__desc">
              {link.id === 'line' ? 'Add the official account for skin health tips' : 'Follow for the latest skin health tips and clinic news'}
            </span>
          </a>
        ))
      }
    </div>

    <p class="hint--sm" style="margin-top:32px;">
      This website does not offer online consultations or advice on individual cases. Any diagnosis or treatment advice requires an in-person examination by a doctor.
    </p>
  </section>
</BaseLayout>
