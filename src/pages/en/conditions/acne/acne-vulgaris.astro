---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ConditionHero from '../../../../components/ConditionHero.astro';
import ImageSlot from '../../../../components/ImageSlot.astro';
import SymptomTreatmentTable from '../../../../components/SymptomTreatmentTable.astro';
import Faq from '../../../../components/Faq.astro';
import PageNotes from '../../../../components/PageNotes.astro';
import heroAcne from '../../../../assets/local/hero-acne.webp';
import {
  ACNE_FAQ,
  ACNE_PRINCIPLES,
  ACNE_RISK_FACTORS,
  ACNE_STAGES,
  ACNE_STRATEGY,
  ACNE_STRATEGY_NOTES,
  ACNE_SYMPTOMS,
  ACNE_TREATMENT_CATEGORIES,
} from '../../../../data/en/acne.js';
import { CONTACT_LINKS } from '../../../../consts.js';
import { inlineBold } from '../../../../lib/inline-bold.js';

const booking = CONTACT_LINKS.find((l) => l.id === 'booking');

const description =
  'A patient guide to acne (acne vulgaris): the four stages of how a spot forms, risk factors, and treatment options including topical retinoids, benzoyl peroxide, oral antibiotics, isotretinoin and lasers, with tips on using them safely.';
---

<BaseLayout title="Acne (acne vulgaris)" description={description} current="conditions">
  <ConditionHero
    fitTitle
    eyebrow="Common skin condition"
    hook="Breakouts that won’t stop?|Blotchy, uneven skin?"
    promise="Work with a dermatologist|toward smoother, clearer skin"
    lead="About 85% of teenagers get acne, and adults can too. It is linked to clogged follicles, oil, acne bacteria and inflammation. With proper treatment, the right skincare and regular habits, most people’s acne can be well controlled."
    image={heroAcne}
    imageAlt="Illustration of acne: a schoolgirl with spots on her face resting her chin on her hand in a classroom, looking worried"
    crumb={{ href: '/en/conditions/acne/', label: 'Acne & acne scars', current: 'Acne' }}
    sections={[
      { id: 'mechanism', label: 'What causes it' },
      { id: 'risk', label: 'Risk factors' },
      { id: 'treatments', label: 'Treatments' },
      { id: 'strategy', label: 'By severity' },
      { id: 'principles', label: 'Key principles' },
      { id: 'faq', label: 'FAQ' },
    ]}
  />

  <section class="wrap" style="padding-block:40px 90px;">
    <h2 class="section-title" style="margin-bottom:12px;" id="mechanism">How does a spot form?</h2>
    <p class="lede">
      The medical name for acne is acne vulgaris. A spot generally develops in the four stages below.
    </p>

    <ol class="stage-list">
      {
        ACNE_STAGES.map((stage, i) => (
          <li class="stage-list__item">
            <span class="stage-list__num" aria-hidden="true">{i + 1}</span>
            <span class="stage-list__body">
              <span class="stage-list__text">{stage.title}</span>
              <span class="stage-list__desc">{stage.desc}</span>
            </span>
          </li>
        ))
      }
    </ol>

    <ImageSlot
      id="acne-mechanism"
      radius={14}
      alt="How a spot forms, in four cross-section diagrams: oil glands make more oil; dead skin cells block the pore and form a comedone; acne bacteria multiply and trigger inflammation; the follicle becomes inflamed and bursts, forming a cyst"
      placeholder="How a spot forms (coming soon)"
      style="width:100%;aspect-ratio:16/9;margin:22px 0 36px;"
      width={1052}
      widths={[700, 1052, 1400, 2048]}
      sizes="(min-width: 1148px) 1052px, 92vw"
    />

    <h2 class="section-title" id="risk">Risk factors for acne</h2>
    <p class="hint">Acne has different causes in different people. Any of the following can make spots more likely.</p>
    <ul class="risk-list">
      {
        ACNE_RISK_FACTORS.map((f) => (
          <li class="risk-list__item">
            <span class="risk-list__title">{f.label}</span>
            {f.desc && <span class="risk-list__desc" set:html={inlineBold(f.desc)} />}
          </li>
        ))
      }
    </ul>

    <h2 class="section-title" style="margin-top:44px;" id="treatments">Treatment options</h2>
    <p class="notice notice--warn" style="margin:0 0 16px;">
      ⚠ The actual medicines and treatments must be decided by your doctor based on the extent, location and severity of your acne and your circumstances. The information below is general education, not personal medical advice.
    </p>
    <p class="hint">
      In Taiwan, acne medicines are either prescription-only or available from a pharmacist. For mild acne in a small area, you can ask a pharmacist about over-the-counter options (such as topical tretinoin or benzoyl peroxide). For long-lasting, severe or widespread acne, see a dermatologist for prescription treatment, such as oral isotretinoin or oral or topical antibiotics.
    </p>
    <SymptomTreatmentTable categories={ACNE_TREATMENT_CATEGORIES} symptoms={ACNE_SYMPTOMS} oneRow />

    <p class="warn-note" style="margin-top:22px;">
      ⚠ Co-trimoxazole (common brand names include Septrin and Baktar) has caused serious reactions such as Stevens–Johnson syndrome, severe liver failure and bone marrow suppression, so the consensus advises against using it for acne.
    </p>
    <p class="hint--sm" style="margin-top:12px;">
      Newer medicines such as clascoterone (a topical anti-androgen) and sarecycline (a newer tetracycline antibiotic) are not yet licensed in Taiwan.
    </p>

    <h2 class="section-title" style="margin-top:44px;" id="strategy">Choosing treatment by severity</h2>
    <p class="hint">
      This table summarizes the Taiwanese Dermatological Association consensus. First line and second line do not mean you must go in that order; you and your doctor will decide based on your situation.
    </p>
    <div class="treatment-table-wrap">
      <table class="treatment-table treatment-table--plain" role="table">
        <thead role="rowgroup">
          <tr role="row">
            <th scope="col" role="columnheader">Severity</th>
            <th scope="col" role="columnheader">First line</th>
            <th scope="col" role="columnheader">Second line</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            ACNE_STRATEGY.map((r) => (
              <tr role="row">
                <th scope="row" role="rowheader" class="treatment-table__name">{r.name}</th>
                <td role="cell" data-label="First line">
                  <ul class="cell-list">{r.first.map((x) => <li>{x}</li>)}</ul>
                  {r.note && <p class="cell-note">{r.note}</p>}
                </td>
                <td role="cell" data-label="Second line">
                  <ul class="cell-list">{r.second.map((x) => <li>{x}</li>)}</ul>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <ul class="bullets" style="margin-top:16px;">
      {ACNE_STRATEGY_NOTES.map((n) => <li>{n}</li>)}
    </ul>

    <p style="margin-top:30px;">
      <a class="btn" href={booking.href} target="_blank" rel="noopener noreferrer">Book an appointment →</a>
    </p>

    <h2 class="section-title" style="margin-top:48px;" id="principles">Key principles</h2>
    <p class="hint">Beyond medicines, these ideas make a difference to how well treatment works and whether acne comes back.</p>
    <ul class="trigger-grid">
      {
        ACNE_PRINCIPLES.map((p) => (
          <li class="trigger-card">
            <span class="trigger-card__label">{p.label}</span>
            <span class="trigger-card__desc">{p.desc}</span>
          </li>
        ))
      }
    </ul>

    <Faq items={ACNE_FAQ} idPrefix="faq-ac" />

    <PageNotes
      sources={[
        'Taiwanese Dermatological Association: Clinical consensus on acne treatment (consensus meeting, March 2024)',
        {
          label: 'Taiwan Food and Drug Administration: So many acne medicines — how do you use them? Topical and oral treatments explained (Drug and Food Safety Weekly, issue 1083; in Chinese)',
          href: 'https://www.fda.gov.tw/tc/PublishOtherEpaperContent.aspx?id=1625&tid=5666&r=90637442',
        },
        {
          label: 'National Taiwan University Hospital e-newsletter: Laser advances in acne treatment — long-lasting oil control without medication (by Dr. Chen, June 2026; in Chinese)',
          href: 'https://health.ntuh.gov.tw/health/NTUH_e_Net/NTUH_e_Net_no247/%E9%9B%B7%E5%B0%84%E9%9D%A9%E6%96%B0%E6%8A%97%E7%97%98.pdf',
        },
        {
          label: 'Jih MH, et al. The 1450-nm diode laser for facial inflammatory acne vulgaris: dose-response and 12-month follow-up study. J Am Acad Dermatol. 2006',
          href: 'https://pubmed.ncbi.nlm.nih.gov/16781297/',
        },
        {
          label: 'NOWnews (Health & Medicine Network): report on blue laser treatment for acne (April 2023; in Chinese)',
          href: 'https://www.nownews.com/news/6109447',
        },
      ]}
      imageNote="The illustrations of people and the diagrams on this page are for illustration only and are not images of real patients."
    />
  </section>
</BaseLayout>

<script>
  import '../../../../scripts/aga.js';
</script>
