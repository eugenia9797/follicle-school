---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ConditionHero from '../../../../components/ConditionHero.astro';
import CystAnimation from '../../../../components/CystAnimation.astro';
import Faq from '../../../../components/Faq.astro';
import PageNotes from '../../../../components/PageNotes.astro';
import heroCyst from '../../../../assets/local/hero-epidermal-cyst.webp';
import {
  CYST_ANIM,
  CYST_CAUSES,
  CYST_FAQ,
  CYST_FEATURES,
  CYST_INTRO,
  CYST_RISK,
  CYST_SEE_DOCTOR,
  CYST_SOURCES,
  CYST_TREATMENTS,
} from '../../../../data/en/epidermal-cyst.js';
import { CONTACT_LINKS } from '../../../../consts.js';
import { inlineBold } from '../../../../lib/inline-bold.js';

const booking = CONTACT_LINKS.find((l) => l.id === 'booking');

const description =
  'A patient guide to epidermal cysts: what causes them, who is at higher risk, how they look and feel, and why squeezing out the keratin cannot cure one — only removing the whole sac can. Written by board-certified dermatologist Dr. I-Hsin Huang.';
---

<BaseLayout title="Epidermal cyst" description={description} current="conditions">
  <ConditionHero
    eyebrow="Common skin lump"
    hook="A firm lump under the skin,|squeezed out but back again?"
    promise="To cure a cyst,|the whole sac has to go!"
    lead="An epidermal cyst is a small sac in the skin. It is benign and not contagious, but it will not go away on its own. Squeezing only gets rid of the keratin inside; the sac stays, so cysts often return. Once you see how one is built, it is clear why complete removal is what cures it."
    image={heroCyst}
    imageAlt="Illustration of an epidermal cyst: a skin cross-section showing a keratin-filled sac in the dermis, connected to the surface by a tiny opening"
    crumb={{ href: '/en/conditions/common/', label: 'Common skin conditions', current: 'Epidermal cyst' }}
    sections={[
      { id: 'cause', label: 'What causes it' },
      { id: 'risk', label: 'Who is at risk' },
      { id: 'features', label: 'Signs & symptoms' },
      { id: 'why', label: 'Why squeezing fails' },
      { id: 'treatment', label: 'Treatment' },
      { id: 'faq', label: 'FAQ' },
    ]}
  />

  <section class="wrap" style="padding-block:40px 90px;">
    <h2 class="section-title" style="margin-bottom:12px;" id="cause">What causes an epidermal cyst?</h2>
    <p class="lede">{CYST_INTRO}</p>
    <ul class="trigger-grid">
      {
        CYST_CAUSES.map((c) => (
          <li class="trigger-card">
            <span class="trigger-card__label">{c.label}</span>
            <span class="trigger-card__desc">{c.desc}</span>
          </li>
        ))
      }
    </ul>

    <h2 class="section-title" style="margin-top:44px;" id="risk">Who is at higher risk?</h2>
    <p class="hint">Anyone can get one, but the situations below make them more common.</p>
    <ul class="risk-list">
      {
        CYST_RISK.map((f) => (
          <li class="risk-list__item">
            <span class="risk-list__title">{f.label}</span>
            <span class="risk-list__desc" set:html={inlineBold(f.desc)} />
          </li>
        ))
      }
    </ul>

    <h2 class="section-title" style="margin-top:44px;" id="features">Signs and symptoms</h2>
    <ul class="bullets">
      {CYST_FEATURES.map((item) => <li>{item}</li>)}
    </ul>
    <p class="notice notice--warn" style="margin:20px 0 8px;">⚠ See a doctor soon if any of these happen:</p>
    <ul class="bullets">
      {CYST_SEE_DOCTOR.map((item) => <li>{item}</li>)}
    </ul>

    <h2 class="section-title" style="margin-top:48px;" id="why">Why does it come back after squeezing?</h2>
    <p class="lede">
      Many people squeeze a cyst open and push out what is inside, and it seems to be gone. But the real problem is not the keratin inside — it is the <strong>wall that makes it</strong>. The animation below compares the two approaches in cross-section.
    </p>
    <CystAnimation copy={CYST_ANIM} />

    <h2 class="section-title" style="margin-top:48px;" id="treatment">Treatment</h2>
    <p class="notice notice--warn" style="margin:0 0 16px;">
      ⚠ 實際Treatment需由醫師依粉瘤的大小、位置與是否發炎評估決定，以下僅為衛教說明，並非個人化醫療建議。
    </p>
    <ul class="risk-list">
      {
        CYST_TREATMENTS.map((f) => (
          <li class="risk-list__item">
            <span class="risk-list__title">{f.label}</span>
            <span class="risk-list__desc" set:html={inlineBold(f.desc)} />
          </li>
        ))
      }
    </ul>

    <p style="margin-top:30px;">
      <a class="btn" href={booking.href} target="_blank" rel="noopener noreferrer">Book an appointment →</a>
    </p>

    <Faq items={CYST_FAQ} idPrefix="faq-cy" />

    <PageNotes sources={CYST_SOURCES} imageNote="The illustrations and animation on this page are schematic and are not images of real patients." />
  </section>
</BaseLayout>

<script>
  // FAQ expand/collapse, shared with the other skin condition pages
  import '../../../../scripts/aga.js';
</script>
