---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConditionHero from '../../../components/ConditionHero.astro';
import ImageSlot from '../../../components/ImageSlot.astro';
import StageAccordion from '../../../components/StageAccordion.astro';
import Faq from '../../../components/Faq.astro';
import SymptomTreatmentTable from '../../../components/SymptomTreatmentTable.astro';
import Lightbox from '../../../components/Lightbox.astro';
import PageNotes from '../../../components/PageNotes.astro';
import heroRosacea from '../../../assets/local/hero-rosacea.webp';
import {
  ROSACEA_FAQ,
  ROSACEA_SELFCARE,
  ROSACEA_SYMPTOMS,
  ROSACEA_TREATMENT_CATEGORIES,
  ROSACEA_TRIGGERS,
  ROSACEA_TYPES,
} from '../../../data/en/rosacea.js';
import { CONTACT_LINKS } from '../../../consts.js';

const booking = CONTACT_LINKS.find((l) => l.id === 'booking');

const lightboxes = ROSACEA_TREATMENT_CATEGORIES.flatMap((c) => c.treatments)
  .map((t) => t.lightbox)
  .filter(Boolean);

const description =
  'A patient guide to rosacea: long-term facial redness driven by genes, blood vessels, nerves and the immune system; its four forms (redness, bumps and pus spots, thickened skin, eye involvement); the role of Demodex mites; and topical, oral and laser treatment options.';
---

<BaseLayout title="Rosacea" description={description} current="conditions">
  <ConditionHero
    eyebrow="Chronic inflammatory skin condition"
    hook="Is your face always red, hot and stinging?"
    promise="Rosacea can be kept under control long-term."
    lead="Rosacea is not just sensitive skin, and it is not caused by poor cleansing. It is a long-term condition linked to genes, blood vessels, nerves and the immune system. Finding your triggers and getting the right treatment can help your skin settle down."
    image={heroRosacea}
    imageAlt="Illustration of rosacea: a woman looking in the mirror with flushed cheeks and small red bumps"
    crumb={{ href: '/en/conditions/', label: 'Skin conditions', current: 'Rosacea' }}
    sections={[
      { id: 'mechanism', label: 'What causes it' },
      { id: 'types', label: 'Types' },
      { id: 'demodex', label: 'Demodex mites' },
      { id: 'care', label: 'Daily care' },
      { id: 'treatments', label: 'Treatments' },
      { id: 'faq', label: 'FAQ' },
    ]}
  />

  <section class="wrap" style="padding-block:40px 90px;">
    <h2 class="section-title" style="margin-bottom:12px;" id="mechanism">What causes rosacea?</h2>
    <p class="lede">
      Rosacea does not have a single cause. In skin with an inherited tendency, outside triggers such as heat, sun, spicy food, alcohol and emotional stress set off an overactive innate immune response, while blood vessels and nerve endings become oversensitive. As vessels widen again and again and inflammatory signals keep building up, the result is repeated redness, bumps, burning and stinging.
    </p>

    <ul class="trigger-grid">
      {
        ROSACEA_TRIGGERS.map((t) => (
          <li class="trigger-card">
            <span class="trigger-card__label">{t.label}</span>
            <span class="trigger-card__desc">{t.desc}</span>
          </li>
        ))
      }
    </ul>

    <ImageSlot
      id="rosacea-mechanism"
      radius={14}
      alt="Diagram of what causes rosacea: genes, heat, spice and emotion, the immune system and overactive nerves and vessels all acting on the skin"
      placeholder="Rosacea diagram (coming soon)"
      style="width:100%;aspect-ratio:16/9;margin:18px 0 36px;"
      width={1052}
      widths={[700, 1052, 1400, 2104]}
      sizes="(min-width: 1148px) 1052px, 92vw"
      loading="eager"
    />

    <h2 class="section-title" id="types">Types of rosacea</h2>
    <p class="hint">Tap a card to read more. More than one type can appear at the same time, and they can change over time.</p>
    <StageAccordion
      stages={ROSACEA_TYPES}
      slotPrefix="rosacea-type-"
      variant="condition"
      chipMin={150}
      placeholder="Illustration (coming soon)"
      imgAspect="4 / 3"
      photos
    />

    <h2 class="section-title" style="margin-top:44px;" id="demodex">Demodex mites</h2>
    <p class="lede">
      Demodex mites are tiny mites that normally live on human skin. Most people have them, and they usually cause no problems. But studies show that people with rosacea often have noticeably more of them on the face. The mites, their waste and the bacteria inside them can further stimulate the immune system and worsen inflammation — a link most often discussed for the bumps-and-pus-spots type.
    </p>
    <p class="lede" style="margin-top:14px;">
      Whether you need a Demodex test is for your doctor to judge from how your skin looks. If needed, a <strong>Demodex skin test</strong> checks whether the number of mites is raised. In a positive test, large numbers of mites can be seen under the microscope, as in the pictures and video below.
    </p>
    <p class="lede" style="margin-top:14px;">
      If an overgrowth of mites is confirmed, it can be treated with <strong>Soolantra</strong>, an ivermectin cream that both lowers the number of mites and calms inflammation.
    </p>

    <div class="demodex-grid">
      <figure class="demodex-figure">
        <ImageSlot
          id="rosacea-demodex-cartoon"
          radius={12}
          alt="Illustration of Demodex mites living in a hair follicle"
          placeholder="Demodex illustration (coming soon)"
          style="width:100%;aspect-ratio:1/1;"
          width={520}
          widths={[420, 520, 1040]}
          sizes="(min-width: 760px) 500px, 92vw"
        />
        <figcaption>Illustration of Demodex mites living in a hair follicle</figcaption>
      </figure>
      <figure class="demodex-figure">
        <ImageSlot
          id="rosacea-demodex-micrograph"
          radius={12}
          alt="Demodex mites under the microscope"
          placeholder="Demodex under the microscope (coming soon)"
          style="width:100%;aspect-ratio:1/1;"
          width={520}
          widths={[420, 520, 1040]}
          sizes="(min-width: 760px) 500px, 92vw"
        />
        <figcaption>Demodex mites under the microscope</figcaption>
      </figure>
    </div>

    <figure class="demodex-video">
      <video
        controls
        muted
        loop
        playsinline
        preload="metadata"
        poster="/videos/demodex-poster.jpg"
        aria-label="Video of live Demodex mites under the microscope"
      >
        <source src="/videos/demodex.mp4" type="video/mp4" />
        Your browser does not support video playback.
      </video>
      <figcaption>Live Demodex mites under the microscope</figcaption>
    </figure>

    <h2 class="section-title" style="margin-top:44px;" id="care">Daily care</h2>
    <p class="hint">Alongside treatment, steady daily care is key to keeping rosacea under control long-term.</p>
    <ul class="bullets">
      {ROSACEA_SELFCARE.map((item) => <li>{item}</li>)}
    </ul>
    <ImageSlot
      id="rosacea-care"
      radius={14}
      alt="Daily care for rosacea: find and avoid your triggers, don’t over-cleanse or scrub, protect against UV, and use gentle skincare free of alcohol and fragrance"
      placeholder="Rosacea daily care illustration (coming soon)"
      style="width:100%;aspect-ratio:16/9;margin:6px 0 0;"
      width={1052}
      widths={[700, 1052, 1400, 2048]}
      sizes="(min-width: 1148px) 1052px, 92vw"
    />

    <h2 class="section-title" style="margin-top:44px;" id="treatments">Treatment options</h2>
    <p class="notice notice--warn" style="margin:0 0 16px;">
      ⚠ The actual medicines and treatments must be decided by your doctor based on your type of rosacea, how severe it is and your circumstances. The information below is general education, not personal medical advice.
    </p>
    <SymptomTreatmentTable categories={ROSACEA_TREATMENT_CATEGORIES} symptoms={ROSACEA_SYMPTOMS} />

    <p class="warn-note" style="margin-top:22px;">
      ⚠ Do not use topical steroids long-term on your own. They may make redness look better at first, but over time they thin the skin, make blood vessels more visible and cause worse rebound redness when stopped — and can even cause steroid-induced rosacea.
    </p>

    <p style="margin-top:30px;">
      <a class="btn" href={booking.href} target="_blank" rel="noopener noreferrer">Book an appointment →</a>
    </p>

    <Faq items={ROSACEA_FAQ} idPrefix="faq-r" />

    <PageNotes
      sources={[
        'Standard classification and pathophysiology of rosacea: The 2017 update by the National Rosacea Society Expert Committee',
        {
          label: 'National Rosacea Society | Faces of Rosacea',
          href: 'https://www.rosacea.org/patients/faces-of-rosacea',
        },
        'Taiwanese Dermatological Association: 2023 consensus handbook on the treatment of rosacea',
      ]}
      imageNote="The illustrations of people on this page are for illustration only; the clinical photos are taken from the sources above to show what each type looks like."
    />
  </section>

  <Lightbox lightboxes={lightboxes} />
</BaseLayout>

<script>
  import '../../../scripts/aga.js';
</script>
