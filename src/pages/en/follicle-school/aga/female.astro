---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ConditionHero from '../../../../components/ConditionHero.astro';
import ImageSlot from '../../../../components/ImageSlot.astro';
import StageAccordion from '../../../../components/StageAccordion.astro';
import TreatmentComparison from '../../../../components/TreatmentComparison.astro';
import Faq from '../../../../components/Faq.astro';
import PageNotes from '../../../../components/PageNotes.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import { hairContent } from '../../../../lib/hair-content.js';
import { buildCategories, collectLightboxes } from '../../../../lib/treatments.js';
import { t } from '../../../../i18n/index.js';
import heroFemale from '../../../../assets/local/hero-female.webp';

const { FEMALE_FAQ, FEMALE_STAGES } = hairContent('en');
const categories = buildCategories('female', 'en');
const lightboxes = collectLightboxes(categories);
const { costDisclaimer } = t('en');

const description =
  'A patient guide to female pattern hair loss (FPHL): what causes diffuse thinning on top of the head, the Ludwig stages and “Christmas tree” pattern, what doctors see under the dermatoscope, and how anti-androgens, minoxidil, LLLT and PRP compare on evidence and cost.';

const warningBanner =
  'Items with a red background in the table carry important warnings for women who could become pregnant. Please read their notes carefully.';
---

<BaseLayout title="Pattern hair loss in women" description={description} current="aga" shell="hair">

  <ConditionHero
    crumb={{ href: '/en/follicle-school/aga/', label: 'Pattern hair loss', current: 'In women' }}
    eyebrow="Pattern hair loss · Women"
    hook="Women get pattern hair loss too?"
    promise="The right diagnosis is where renewed confidence begins."
    lead="Pattern hair loss in women, also called female pattern hair loss, has more complex causes than in men and is harder to treat. Confirming the diagnosis early and planning treatment can help slow the loss, keep the hair you have, and help you feel confident again."
    image={heroFemale}
    imageAlt="Illustration of female pattern hair loss: a woman looking at hair in the drain, with a widening parting"
    sections={[
        { id: 'mechanism', label: 'What causes it' },
        { id: 'stages', label: 'Ludwig stages' },
        { id: 'dermoscopy', label: 'Under the dermatoscope' },
        { id: 'treatments', label: 'Treatments' },
        { id: 'faq', label: 'FAQ' },
      ]}
  />

  <section class="wrap" style="padding-block:40px 90px;">
    <h2 class="section-title" style="margin-bottom:12px;" id="mechanism">What causes it?</h2>
    <p class="lede">
      Pattern hair loss in women is also known as female pattern hair loss (FPHL). It works in a similar way to men’s, depending on how sensitive the follicles are to androgens and on inherited tendency. But women have lower androgen levels in the blood, so hair usually thins diffusely rather than receding in one area. When diagnosing it, doctors look carefully for polycystic ovary syndrome (PCOS) or other hormone problems, and arrange blood tests if needed (such as thyroid function, ferritin and androgen levels) to rule out other causes.
    </p>
    <ImageSlot
      id="female-mechanism"
      radius={14}
      alt="Diagram of what causes female pattern hair loss: genetics, metabolism and menopause lead to androgens being turned into DHT, while estrogen’s protective effect declines, and follicles gradually shrink"
      placeholder="Female pattern hair loss diagram (coming soon)"
      style="width:100%;aspect-ratio:16/9;margin:18px 0 36px;"
      width={1052}
      widths={[700, 1052, 1400, 2104]}
      sizes="(min-width: 1148px) 1052px, 92vw"
      loading="eager"
    />

    <h2 class="section-title" id="stages">How it looks and progresses: the Ludwig scale</h2>
    <p class="hint">
      Tap a stage to read more. Doctors may also use the Sinclair scale (grades 1–5) and the “Christmas tree” pattern to describe how much the top of the head has thinned.
    </p>
    <StageAccordion
      stages={FEMALE_STAGES}
      slotPrefix="ludwig-stage-"
      scaleName=""
      chipMin={140}
      placeholder="Ludwig stage illustration (coming soon)"
    />
    <ImageSlot
      id="ludwig-overview"
      radius={14}
      width={842}
      densities={[1, 2]}
      alt="Overview of the Ludwig scale for female pattern hair loss"
      placeholder="Ludwig scale overview (coming soon)"
      style="width:80%;aspect-ratio:1448/1086;margin-bottom:36px;"
    />

    <h2 class="section-title" style="margin-top:32px;" id="dermoscopy">What doctors see under the dermatoscope</h2>
    <ul class="bullets">
      <li>More than 20% variation in hair thickness within the same area; hairs become finer and softer, like vellus hairs (red arrows)</li>
      <li>Yellow dots: empty follicle openings (*)</li>
      <li>More follicle units with only a single hair (fewer hairs per unit)</li>
      <li>The front hairline is usually kept — a key difference from the male pattern</li>
    </ul>
    <div class="derm-grid">
      <ImageSlot id="female-derm-1" radius={12} width={342} densities={[1, 2]} alt="Variation in hair thickness and vellus-like hairs under the dermatoscope; the red arrows point to thinned hairs" placeholder="Variation in hair thickness (coming soon)" />
      <ImageSlot id="female-derm-2" radius={12} width={342} densities={[1, 2]} alt="Yellow dots under the dermatoscope" placeholder="Yellow dots (coming soon)" />
      <ImageSlot id="female-derm-3" radius={12} width={342} densities={[1, 2]} alt="Dermoscopy image of the scalp in female pattern hair loss" placeholder="Dermoscopy image (coming soon)" />
    </div>

    <TreatmentComparison categories={categories} banners={[costDisclaimer, warningBanner]} />

    <Faq items={FEMALE_FAQ} idPrefix="faq-f" />

    <PageNotes />
  </section>

  <Lightbox lightboxes={lightboxes} />
</BaseLayout>

<script>
  import '../../../../scripts/aga.js';
</script>
