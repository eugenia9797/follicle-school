---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ConditionHero from '../../../../components/ConditionHero.astro';
import ImageSlot from '../../../../components/ImageSlot.astro';
import StageAccordion from '../../../../components/StageAccordion.astro';
import TreatmentComparison from '../../../../components/TreatmentComparison.astro';
import Faq from '../../../../components/Faq.astro';
import PageNotes from '../../../../components/PageNotes.astro';
import Lightbox from '../../../../components/Lightbox.astro';
import { hairContent } from '../../../../lib/hair-content.js';
import { buildCategories, collectLightboxes } from '../../../../lib/treatments.js';
import { t } from '../../../../i18n/index.js';
import heroMale from '../../../../assets/local/hero-male.webp';

const { MALE_FAQ, NORWOOD_STAGES } = hairContent('en');
const categories = buildCategories('male', 'en');
const lightboxes = collectLightboxes(categories);
const { costDisclaimer } = t('en');

const description =
  'A patient guide to male pattern hair loss: how DHT shrinks hair follicles, the Hamilton–Norwood stages, what doctors see under the dermatoscope, and how oral and topical medicines, LLLT, PRP and hair transplants compare on evidence, effect and cost.';
---

<BaseLayout title="Pattern hair loss in men" description={description} current="aga" shell="hair">

  <ConditionHero
    crumb={{ href: '/en/follicle-school/aga/', label: 'Pattern hair loss', current: 'In men' }}
    eyebrow="Pattern hair loss · Men"
    hook="Is it all down to male hormones?"
    promise="Starting treatment early makes a real difference."
    lead="Male pattern hair loss is linked to genetics and male hormones. Getting assessed early and combining treatments tends to work better than relying on one alone — so a hair transplant doesn’t have to be your only option."
    image={heroMale}
    imageAlt="Illustration of male pattern hair loss: a man checking his thinning crown in the mirror"
    sections={[
        { id: 'mechanism', label: 'What causes it' },
        { id: 'stages', label: 'Norwood stages' },
        { id: 'dermoscopy', label: 'Under the dermatoscope' },
        { id: 'treatments', label: 'Treatments' },
        { id: 'faq', label: 'FAQ' },
      ]}
  />

  <section class="wrap" style="padding-block:40px 90px;">
    <h2 class="section-title" style="margin-bottom:12px;" id="mechanism">What causes it?</h2>
    <p class="lede">
      In the hair follicle, the enzyme 5-alpha reductase turns testosterone into dihydrotestosterone (DHT). When DHT binds to androgen receptors, follicles that are genetically sensitive gradually shrink — a process called miniaturization. The growth phase gets shorter, hairs become finer and softer, and eventually the follicle stops producing visible hair. This is strongly inherited and involves many genes.
    </p>
    <ImageSlot
      id="male-mechanism"
      radius={14}
      alt="Diagram of follicle miniaturization: testosterone is turned into DHT by 5-alpha reductase, and the follicle gradually shrinks"
      placeholder="Follicle miniaturization diagram (coming soon)"
      style="width:100%;aspect-ratio:16/9;margin:18px 0 36px;"
      width={1052}
      widths={[700, 1052, 1400, 2104]}
      sizes="(min-width: 1148px) 1052px, 92vw"
      loading="eager"
    />

    <h2 class="section-title" id="stages">How it looks and progresses: the Hamilton–Norwood scale</h2>
    <p class="hint">Tap a stage to read more</p>
    <StageAccordion
      stages={NORWOOD_STAGES}
      slotPrefix="norwood-stage-"
      scaleName="Hamilton–Norwood "
      chipMin={110}
      vertexStageId="III"
    />
    <ImageSlot
      id="norwood-overview"
      radius={14}
      alt="Overview of the Hamilton–Norwood scale for male pattern hair loss"
      placeholder="Hamilton–Norwood scale overview (coming soon)"
      style="width:100%;height:550px;margin-bottom:36px;"
    />

    <h2 class="section-title" style="margin-top:32px;" id="dermoscopy">What doctors see under the dermatoscope</h2>
    <ul class="bullets">
      <li>More than 20% variation in hair thickness within the same area; hairs become finer and softer, like vellus hairs (red arrows)</li>
      <li>Yellow dots: empty follicle openings (*)</li>
      <li>More follicle units with only a single hair (fewer hairs per unit)</li>
      <li>Follicle density clearly lower at the front and crown than at the back of the head</li>
    </ul>
    <div class="derm-grid">
      <ImageSlot id="male-derm-1" radius={12} width={342} densities={[1, 2]} alt="Dermoscopy image of male pattern hair loss" placeholder="Dermoscopy image (coming soon)" />
      <ImageSlot id="male-derm-2" radius={12} width={342} densities={[1, 2]} alt="Yellow dots under the dermatoscope" placeholder="Yellow dots (coming soon)" />
      <ImageSlot id="male-derm-3" radius={12} width={342} densities={[1, 2]} alt="Variation in hair thickness under the dermatoscope" placeholder="Variation in hair thickness (coming soon)" />
    </div>

    <TreatmentComparison categories={categories} banners={[costDisclaimer]} />

    <Faq items={MALE_FAQ} idPrefix="faq-m" />

    <PageNotes />
  </section>

  <Lightbox lightboxes={lightboxes} />
</BaseLayout>

<script>
  import '../../../../scripts/aga.js';
</script>
