---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ConditionHero from '../../../components/ConditionHero.astro';
import ImageSlot from '../../../components/ImageSlot.astro';
import StageAccordion from '../../../components/StageAccordion.astro';
import TreatmentComparison from '../../../components/TreatmentComparison.astro';
import Faq from '../../../components/Faq.astro';
import PageNotes from '../../../components/PageNotes.astro';
import Lightbox from '../../../components/Lightbox.astro';
import { FEMALE_FAQ, FEMALE_STAGES } from '../../../data/TreatmentData.js';
import { buildCategories, collectLightboxes } from '../../../lib/treatments.js';
import { COST_DISCLAIMER } from '../../../consts.js';
import heroFemale from '../../../assets/local/hero-female.webp';

const categories = buildCategories('female');
const lightboxes = collectLightboxes(categories);

const description =
  '女性雄性禿（FPHL）衛教：瀰漫性頭頂稀疏的致病機轉、Ludwig 分期與聖誕樹型分布、皮膚鏡表現，以及抗雄性素藥物、Minoxidil、LLLT、PRP 等治療的證據等級與費用比較。';

const warningBanner = '表格中標示紅色背景的項目，屬於育齡婦女使用之重要警示，請務必詳閱注意事項。';
---

<BaseLayout title="雄性禿：女性版（女性形態落髮）" description={description} current="aga" shell="hair">

  <ConditionHero
    crumb={{ href: '/follicle-school/aga/', label: '雄性禿', current: '女性版' }}
    eyebrow="雄性禿・女性"
    hook="女生也有雄性禿？"
    promise="正確診斷，重新散髮自信！"
    lead="女性雄性禿又叫女性形態落髮，原因比男性更為複雜，治療更棘手，及早確認診斷、規劃治療，有助延緩落髮、維持髮量，讓你重拾自信！"
    image={heroFemale}
    imageAlt="女性形態落髮示意插圖：女性看著排水孔的落髮，頭頂分線變寬"
    sections={[
        { id: 'mechanism', label: '致病機轉' },
        { id: 'stages', label: 'Ludwig 分期' },
        { id: 'dermoscopy', label: '皮膚鏡表現' },
        { id: 'treatments', label: '治療比較' },
        { id: 'faq', label: '常見問題' },
      ]}
  />

  <section class="wrap" style="padding-block:40px 90px;">
    <h2 class="section-title" style="margin-bottom:12px;" id="mechanism">致病機轉</h2>
    <p class="lede">
      女性的雄性禿又稱為「女性形態落髮」（Female Pattern Hair Loss,
      FPHL）。其機轉與男性類似，皆與毛囊對雄性素的敏感度及遺傳體質有關，但女性血中雄性素濃度較低，落髮型態多為瀰漫性稀疏而非局部後退。診斷時需特別留意是否合併多囊性卵巢症候群（PCOS）或其他內分泌異常，必要時應安排抽血檢查（如甲狀腺功能、鐵蛋白、雄性素相關指標）以排除其他病因。
    </p>
    <ImageSlot
      id="female-mechanism"
      radius={14}
      alt="女性形態落髮致病機轉示意圖：遺傳、代謝與更年期等因素使雄性素轉為 DHT，加上雌激素保護力下降，毛囊逐漸微小化"
      placeholder="女性形態落髮致病機轉示意圖（圖片準備中）"
      style="width:100%;aspect-ratio:16/9;margin:18px 0 36px;"
      width={1052}
      widths={[700, 1052, 1400, 2104]}
      sizes="(min-width: 1148px) 1052px, 92vw"
      loading="eager"
    />

    <h2 class="section-title" id="stages">臨床表現與分期：Ludwig Scale</h2>
    <p class="hint">
      點選各分期卡片查看說明；另可參考 Sinclair 分級（1–5 級）與「聖誕樹型」分布描述頭頂瀰漫性稀疏程度。
    </p>
    <StageAccordion
      stages={FEMALE_STAGES}
      slotPrefix="ludwig-stage-"
      scaleName=""
      chipMin={140}
      placeholder="Ludwig 分期示意圖（圖片準備中）"
    />
    <ImageSlot
      id="ludwig-overview"
      radius={14}
      width={842}
      densities={[1, 2]}
      alt="Ludwig Scale 女性雄性禿分期總圖"
      placeholder="Ludwig Scale 總圖（圖片準備中）"
      style="width:80%;aspect-ratio:1448/1086;margin-bottom:36px;"
    />

    <h2 class="section-title" style="margin-top:32px;" id="dermoscopy">皮膚鏡（Dermoscopy）表現</h2>
    <ul class="bullets">
      <li>同一區域毛髮直徑變異度 &gt; 20%（毛髮粗細不均），頭髮變細軟、汗毛化(vellus-hair like) (紅色箭頭)</li>
      <li>黃點徵象（yellow dots）：空的毛囊開口(*)</li>
      <li>單根毛囊單位比例增加（毛囊單位內毛髮數減少）</li>
      <li>前額髮際線通常保留，與男性型落髮的鑑別重點</li>
    </ul>
    <div class="derm-grid">
      <ImageSlot id="female-derm-1" radius={12} width={342} densities={[1, 2]} alt="皮膚鏡下的毛髮直徑變異與汗毛化，紅色箭頭處為變細的毛髮" placeholder="毛髮直徑變異（圖片準備中）" />
      <ImageSlot id="female-derm-2" radius={12} width={342} densities={[1, 2]} alt="皮膚鏡下的黃點徵象" placeholder="黃點徵象（圖片準備中）" />
      <ImageSlot id="female-derm-3" radius={12} width={342} densities={[1, 2]} alt="女性雄性禿頭皮皮膚鏡影像" placeholder="皮膚鏡影像（圖片準備中）" />
    </div>

    <TreatmentComparison categories={categories} banners={[COST_DISCLAIMER, warningBanner]} />

    <Faq items={FEMALE_FAQ} idPrefix="faq-f" />

    <PageNotes />
  </section>

  <Lightbox lightboxes={lightboxes} />
</BaseLayout>

<script>
  import '../../../scripts/aga.js';
</script>
