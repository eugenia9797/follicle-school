    <p class="simple-page__eyebrow">404</p>
    <h1 class="simple-page__title">找不到這個頁面</h1>
    <p class="simple-page__text">您要找的頁面不存在或已經移動位置。您可以從首頁重新瀏覽各項落髮衛教內容。</p>
    <a class="btn btn--sm" href="/">返回首頁</a>
  </section>
</BaseLayout>
