---
import BaseLayout from './BaseLayout.astro';
import { pageLang, t } from '../i18n/index.js';

const { article, crumbSep } = t(pageLang(Astro));

const { title, description, tag, backHref, backLabel, current, shell, updated } = Astro.props;
---

<BaseLayout title={title} description={description} current={current} shell={shell}>
  <article class="article">
    <header class="article__head">
      <p class="breadcrumb"><a href={backHref}>{backLabel}</a> {crumbSep} {article.column}</p>
      <p class="article__tag">{tag}</p>
      <h1 class="article__title">{title}</h1>
      {updated && <p class="article__meta">{article.updated}{updated}</p>}
    </header>

    <div class="article__body">
      <slot />
    </div>

    <footer class="article__foot">
      <a class="btn btn--sm" href={backHref}>{article.back(backLabel)}</a>
    </footer>
  </article>
</BaseLayout>
