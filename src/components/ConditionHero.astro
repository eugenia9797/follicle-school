---
import { Image } from 'astro:assets';
import { lqipStyle } from '../lib/lqip.js';

/**
 * Opening band for a condition page: the question a reader arrives with, a
 * short reassuring lead, and jump links into the detail below. Everything
 * after this section is the existing long-form content, unchanged.
 */
const { eyebrow, hook, promise, lead, image, imageAlt, sections = [], crumb, fitTitle = false } = Astro.props;

// A "|" in the hook or promise marks where the line may break. Each phrase between
// the bars stays whole, so a long title never splits in the middle of a word.
const parts = (text) => text.split('|');

---

<section class:list={['hero-band', fitTitle && 'hero-band--fit-title']}>
  <div class="hero-band__inner">
    <div class="hero-band__text">
      {crumb && (
        <p class="breadcrumb">
          <a href={crumb.href}>{crumb.label}</a> ／ {crumb.current}
        </p>
      )}
      <p class="hero-band__eyebrow">{eyebrow}</p>
      <h1 class="hero-band__title">
        <span class="hero-band__hook">{hook.includes('|') ? parts(hook).map((t) => <span class="hero-band__phrase">{t}</span>) : hook}</span>
        <span class="hero-band__promise">{promise.includes('|') ? parts(promise).map((t) => <span class="hero-band__phrase">{t}</span>) : promise}</span>
      </h1>
      <p class="hero-band__lead">{lead}</p>
    </div>

    <div class="hero-band__media">
      <Image
        style={lqipStyle(image)}
        src={image}
        alt={imageAlt}
        width={420}
        widths={[420, 840]}
        sizes="(min-width: 900px) 420px, 60vw"
        loading="eager"
      />
    </div>
  </div>

  {
    sections.length > 0 && (
      <nav class="hero-band__nav" aria-label="本頁章節">
        {sections.map((s) => (
          <a href={`#${s.id}`}>{s.label}</a>
        ))}
      </nav>
    )
  }
</section>
