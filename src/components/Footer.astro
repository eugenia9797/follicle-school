---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-esheen-light.png';
import {
  CONTACT_LINKS,
  HAIR_SECTION_BASE,
  HAIR_SECTION_NAME,
  MEDICAL_DISCLAIMER,
  SITE_NAME,
  SITE_TAGLINE,
} from '../consts.js';

// Follicle School has its own shell, so its footer points back at the main
// site rather than around it.
const { shell = 'main' } = Astro.props;

const META_LINKS =
  shell === 'hair'
    ? [
        { label: `${HAIR_SECTION_NAME}首頁`, href: `${HAIR_SECTION_BASE}/` },
        { label: '自我落髮檢測', href: `${HAIR_SECTION_BASE}/quiz/` },
        { label: '醫師介紹', href: '/about/' },
        { label: '← 回 E.sheen 主站', href: '/' },
      ]
    : [
        { label: '醫師介紹', href: '/about/' },
        { label: '皮膚疾病', href: '/conditions/' },
        { label: '醫學美容', href: '/aesthetics/' },
        { label: '聯絡我', href: '/contact/' },
      ];

const year = new Date().getFullYear();

// Booking first: it is the one action every page is working towards.
const CONTACT_ORDER = ['booking', 'line', 'instagram', 'facebook'];
const CONTACT_LABELS = { booking: '線上預約掛號', line: 'LINE 官方帳號' };
const contacts = CONTACT_ORDER.map((id) => {
  const link = CONTACT_LINKS.find((l) => l.id === id);
  return { ...link, text: CONTACT_LABELS[id] ?? link.label };
});

const ICONS = {
  instagram:
    'M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.44.43.7.83.92 1.4.17.42.37 1.06.42 2.24.06 1.28.07 1.66.07 4.88s-.01 3.6-.07 4.88c-.05 1.18-.25 1.82-.42 2.24-.22.57-.48.97-.92 1.4-.42.42-.82.68-1.4.9-.42.17-1.06.37-2.24.42-1.28.06-1.66.07-4.88.07s-3.6-.01-4.88-.07c-1.18-.05-1.82-.25-2.24-.42a3.9 3.9 0 0 1-1.4-.9 3.9 3.9 0 0 1-.9-1.4c-.17-.42-.37-1.06-.42-2.24C2.21 15.6 2.2 15.22 2.2 12s.01-3.6.07-4.88c.05-1.18.25-1.82.42-2.24.22-.57.48-.97.9-1.4a3.9 3.9 0 0 1 1.4-.9c.42-.17 1.06-.37 2.24-.42C8.4 2.21 8.8 2.2 12 2.2Zm0 3.06A6.74 6.74 0 1 0 18.74 12 6.74 6.74 0 0 0 12 5.26Zm0 11.12A4.38 4.38 0 1 1 16.38 12 4.38 4.38 0 0 1 12 16.38Zm6.98-11.4a1.58 1.58 0 1 1-1.57-1.57 1.58 1.58 0 0 1 1.57 1.57Z',
  facebook:
    'M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46H15.2c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.76 8.43-4.92 8.43-9.94Z',
  booking:
    'M7 2v2h10V2h2v2h1a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1V2h2ZM4 9v11h16V9H4Zm3 3h4v4H7v-4Z',
  line: 'M12 3C6.9 3 2.8 6.4 2.8 10.5c0 3.7 3.2 6.8 7.6 7.4.3.06.7.2.8.45.1.23.06.58.03.81l-.13.77c-.04.23-.18.9.79.49.97-.41 5.24-3.09 7.15-5.29 1.32-1.45 1.95-2.92 1.95-4.63C21 6.4 17.1 3 12 3ZM8.3 13h-1.9a.4.4 0 0 1-.4-.4V9.05a.4.4 0 1 1 .8 0v3.15h1.5a.4.4 0 1 1 0 .8Zm1.6-.4a.4.4 0 1 1-.8 0V9.05a.4.4 0 1 1 .8 0v3.55Zm4.1 0a.4.4 0 0 1-.72.24l-1.83-2.48v2.24a.4.4 0 1 1-.8 0V9.05a.4.4 0 0 1 .72-.24l1.83 2.49V9.05a.4.4 0 1 1 .8 0v3.55Zm2.9-2.18a.4.4 0 1 1 0 .8h-1.5v.98h1.5a.4.4 0 1 1 0 .8h-1.9a.4.4 0 0 1-.4-.4V9.05a.4.4 0 0 1 .4-.4h1.9a.4.4 0 1 1 0 .8h-1.5v.97h1.5Z',
};
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="/" aria-label={SITE_NAME}>
          <Image src={logo} alt={SITE_NAME} height={120} densities={[1, 2]} class="site-footer__logo" />
        </a>
        <p class="site-footer__tagline">
          {SITE_TAGLINE}<br />
          讓我陪您重欣出發，找回喜歡自己的樣子。
        </p>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">聯絡預約</h2>
        <ul class="site-footer__list">
          {
            contacts.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener noreferrer">
                  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d={ICONS[link.id]} />
                  </svg>
                  {link.text}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">網站導覽</h2>
        <ul class="site-footer__list">
          {META_LINKS.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="site-footer__disclaimer">⚕ 醫療免責聲明：{MEDICAL_DISCLAIMER}</p>
      <p class="site-footer__copy">© {year} {SITE_NAME}. All rights reserved.</p>
    </div>
  </div>
</footer>
