---
/**
 * Treatment comparison in the same card-then-table form as the hair pages
 * (data-cat-toggle / data-cat-panel are driven by scripts/aga.js), but with no
 * quadrant chart: every treatment is listed, tagged with the clinical features
 * it helps. Used by the rosacea and acne pages.
 *
 * A category may carry `warning` (shown as a caution above its table) or
 * `hint` (a plain line of guidance). When any treatment in it has `cautions` or
 * `advice`, the table gains a fourth column for them. `oneRow` lays four category
 * cards out across a wide screen rather than three and an orphan.
 */
import { inlineBold } from '../lib/inline-bold.js';

const { categories, symptoms, oneRow = false } = Astro.props;
const bySymptom = Object.fromEntries(symptoms.map((s) => [s.id, s]));
// 標籤一律依症狀清單的順序顯示，不受資料裡陣列順序影響
const order = symptoms.map((s) => s.id);
const sorted = (ids) => [...ids].sort((a, b) => order.indexOf(a) - order.indexOf(b));
const hasTips = (cat) => cat.treatments.some((t) => t.cautions?.length || t.advice?.length);
---

<ul class="symptom-key" aria-label="症狀標籤說明">
  {
    symptoms.map((s) => (
      <li>
        <span class={`symptom-chip symptom-chip--${s.id}`}>{s.label}</span>
        <span class="symptom-key__en">{s.en}</span>
      </li>
    ))
  }
</ul>

<p class="hint--sm">點選分類展開治療項目</p>

<div class:list={['cat-grid', oneRow && 'cat-grid--one-row']}>
  {
    categories.map((cat) => (
      <button
        type="button"
        class="cat-card"
        data-cat-toggle={cat.key}
        aria-expanded="false"
        aria-controls={`cat-${cat.key}`}
      >
        <span class="cat-card__top">
          <span class="cat-card__title">{cat.title}</span>
          <span class="cat-card__chevron" aria-hidden="true">⌄</span>
        </span>
        <span class="cat-card__summary">{cat.summary}</span>
      </button>
    ))
  }
</div>

{
  categories.map((cat) => (
    <div class="cat-panel" id={`cat-${cat.key}`} data-cat-panel={cat.key} hidden>
      {cat.warning && <p class="notice notice--warn" style="margin:0;">⚠ {cat.warning}</p>}
      {cat.hint && <p class="hint--sm" style="margin:0;">{cat.hint}</p>}
      <div class="treatment-table-wrap">
        <table class:list={['treatment-table', 'treatment-table--symptoms', hasTips(cat) && 'treatment-table--tips']}>
          <thead>
            <tr>
              <th scope="col">治療方式</th>
              <th scope="col">可改善的症狀</th>
              <th scope="col">作用機轉</th>
              {hasTips(cat) && <th scope="col">使用注意事項與建議</th>}
            </tr>
          </thead>
          <tbody>
            {cat.treatments.map((t) => (
              <tr>
                <th scope="row" class="treatment-table__name">
                  {t.name.split('\n').map((line, i) => (i > 0 ? [<br />, line] : line))}
                  {t.note && <span class="treatment-table__note">{t.note}</span>}
                  {t.lightbox && (
                    <span class="treatment-table__product">
                      <span class="treatment__label">商品樣式</span>
                      <button type="button" class="thumb thumb--open" data-lightbox-open={t.lightbox.id}>
                        <span class="thumb__icon" aria-hidden="true">🔍</span>
                        <span>{t.thumbLabel}</span>
                      </button>
                    </span>
                  )}
                </th>
                <td>
                  <ul class="symptom-list">
                    {sorted(t.helps).map((id) => (
                      <li>
                        <span class={`symptom-chip symptom-chip--${id}`} title={bySymptom[id].en}>
                          {bySymptom[id].label}
                        </span>
                      </li>
                    ))}
                  </ul>
                </td>
                <td class="treatment-table__moa" set:html={inlineBold(t.moa)} />
                {hasTips(cat) && (
                  <td class="treatment-table__tips">
                    {t.cautions?.length > 0 && (
                      <>
                        <p class="tips-label tips-label--caution">注意</p>
                        <ul class="tips-list">
                          {t.cautions.map((x) => <li set:html={inlineBold(x)} />)}
                        </ul>
                      </>
                    )}
                    {t.advice?.length > 0 && (
                      <>
                        <p class="tips-label tips-label--advice">建議</p>
                        <ul class="tips-list">
                          {t.advice.map((x) => <li set:html={inlineBold(x)} />)}
                        </ul>
                      </>
                    )}
                  </td>
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  ))
}
