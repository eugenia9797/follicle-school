---
import { pageLang, t } from '../i18n/index.js';

/**
 * Site search: a magnifier button in the header and a modal with a results
 * list. The index is built by Pagefind after `astro build` (see the build
 * script in package.json) and lives in /pagefind/. Searching runs entirely in
 * the browser; there is no server. Pagefind keeps a separate index per page
 * language, so Chinese pages search Chinese content and /en/ pages English.
 *
 * In `npm run dev` there is no index yet, so the dialog says so instead of failing.
 */
const { search } = t(pageLang(Astro));
---

<button type="button" class="search-btn" data-search-open aria-label={search.open} title={search.open}>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
    <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" />
  </svg>
</button>

<dialog class="search-dialog" data-search-dialog aria-label={search.open}>
  <form class="search-dialog__form" method="dialog" data-search-form>
    <input
      type="search"
      class="search-dialog__input"
      data-search-input
      placeholder={search.placeholder}
      aria-label={search.open}
      autocomplete="off"
      enterkeyhint="search"
    />
    <button type="button" class="search-dialog__close" data-search-close aria-label={search.close}>✕</button>
  </form>
  <div
    class="search-dialog__results"
    data-search-results
    aria-live="polite"
    data-msg-hint={search.hint}
    data-msg-none={search.none}
    data-msg-unavailable={search.unavailable}
  >
    <p class="search-dialog__msg">{search.hint}</p>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]');
  if (dialog) {
    const input = dialog.querySelector<HTMLInputElement>('[data-search-input]')!;
    const box = dialog.querySelector<HTMLElement>('[data-search-results]')!;
    let pagefind: any;
    let timer: number | undefined;
    let seq = 0;

    const message = (text: string) => {
      box.textContent = '';
      const p = document.createElement('p');
      p.className = 'search-dialog__msg';
      p.textContent = text;
      box.append(p);
    };

    async function load() {
      if (pagefind !== undefined) return pagefind;
      try {
        // Loaded through new Function so the bundler leaves this runtime URL alone
        // (the file is generated by `pagefind` after the build, not part of the bundle).
        pagefind = await new Function('u', 'return import(u)')('/pagefind/pagefind.js');
        await pagefind.options({ excerptLength: 22 });
      } catch {
        pagefind = null;
      }
      return pagefind;
    }

    async function run(query: string) {
      const q = query.trim();
      const mine = ++seq;
      if (!q) return message(box.dataset.msgHint!);
      const pf = await load();
      if (!pf) return message(box.dataset.msgUnavailable!);
      const found = await pf.search(q);
      const items = await Promise.all(found.results.slice(0, 8).map((r: any) => r.data()));
      if (mine !== seq) return; // a newer keystroke already replaced this search
      if (!items.length) return message(box.dataset.msgNone!.replace('{q}', q));

      box.textContent = '';
      const list = document.createElement('ul');
      list.className = 'search-dialog__list';
      for (const d of items) {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = d.url;
        const title = document.createElement('span');
        title.className = 'search-dialog__title';
        title.textContent = (d.meta.title || d.url).replace(/\s*[｜|].*$/, '');
        const ex = document.createElement('span');
        ex.className = 'search-dialog__excerpt';
        ex.innerHTML = d.excerpt; // Pagefind escapes the text and only adds <mark>
        a.append(title, ex);
        li.append(a);
        list.append(li);
      }
      box.append(list);
    }

    const open = () => {
      if (!dialog.open) dialog.showModal();
      input.focus();
      input.select();
      load();
    };
    document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
    dialog.querySelector('[data-search-close]')!.addEventListener('click', () => dialog.close());
    // clicking the dimmed backdrop closes it
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => run(input.value), 150);
    });
    document.addEventListener('keydown', (e) => {
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test((e.target as HTMLElement).tagName);
      if ((e.key === 'k' && (e.metaKey || e.ctrlKey)) || (e.key === '/' && !typing)) {
        e.preventDefault();
        open();
      }
    });
  }
</script>
