---
import MobileNav from './MobileNav.astro';
import LangSwitch from './LangSwitch.astro';
import { CONTACT_LINKS, HAIR_SECTION_BASE as BASE } from '../consts.js';
import { localize, pageLang, t } from '../i18n/index.js';

/**
 * Follicle School runs on its own shell: readers who click in from the main
 * site get this header instead of E.sheen's, plus a way back to it.
 */
const { current = '' } = Astro.props;

const lang = pageLang(Astro);
const { site, nav } = t(lang);
const to = (href) => localize(href, lang);

const NAV = [
  { id: 'aga', label: nav.aga, href: to(`${BASE}/aga/`) },
  { id: 'telogen', label: nav.telogen, href: to(`${BASE}/telogen/`) },
  { id: 'areata', label: nav.areata, href: to(`${BASE}/areata/`) },
  { id: 'quiz', label: nav.quiz, href: to(`${BASE}/quiz/`) },
];

const booking = CONTACT_LINKS.find((l) => l.id === 'booking');

const drawerItems = [
  ...NAV,
  { label: nav.bookArrow, href: booking.href, external: true, accent: true },
  { label: nav.backToMain, href: to('/') },
];
---

<header class="fs-header">
  <div class="fs-header__bar">
    <a class="fs-brand" href={to(`${BASE}/`)}>
      <span class="fs-brand__name">{site.hairName}</span>
      <span class="fs-brand__latin">{site.hairLatin}</span>
    </a>

    <nav class="fs-nav" aria-label={nav.hair}>
      {
        NAV.map((item) => (
          <a
            class="fs-nav__link"
            href={item.href}
            aria-current={current === item.id ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a class="fs-nav__home" href={to('/')}>{nav.backToMain}</a>
      <a class="nav__book" href={booking.href} target="_blank" rel="noopener noreferrer">
        {nav.book}
      </a>
    </nav>

    <LangSwitch />

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={nav.openMenu}
    >☰</button>
  </div>

  <MobileNav items={drawerItems} label={nav.mobileHair} />
</header>
