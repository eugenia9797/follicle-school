---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-esheen.png';
import MobileNav from './MobileNav.astro';
import LangSwitch from './LangSwitch.astro';
import { CONTACT_LINKS } from '../consts.js';
import { localize, pageLang, t } from '../i18n/index.js';

// `current` marks the active top-level section.
const { current = '' } = Astro.props;

const lang = pageLang(Astro);
const { site, nav } = t(lang);
const to = (href) => localize(href, lang);

const booking = CONTACT_LINKS.find((l) => l.id === 'booking');
const contact = (id) => CONTACT_LINKS.find((l) => l.id === id).href;

// Each top-level item still links to its own page; `children` is the hover
// menu. Only pages that exist are listed, so there are no dead ends.
const NAV = [
  {
    id: 'about',
    label: nav.about,
    href: to('/about/'),
    children: [
      { label: nav.aboutProfile, href: to('/about/#profile') },
      { label: nav.aboutClinic, href: to('/about/#clinic') },
      { label: nav.aboutInterviews, href: to('/about/#interviews') },
      { label: nav.aboutConferences, href: to('/about/#conferences') },
      { label: nav.aboutTranslation, href: to('/about/#translation') },
      { label: nav.aboutPublications, href: to('/about/#publications') },
    ],
  },
  {
    id: 'conditions',
    label: nav.conditions,
    href: to('/conditions/'),
    children: [
      { label: nav.rosacea, href: to('/conditions/rosacea/') },
      { label: nav.acne, href: to('/conditions/acne/') },
      {
        label: nav.hairLead,
        href: to('/follicle-school/'),
        lead: true,
        // 再展開一層，往右側顯示
        children: [
          { label: nav.aga, href: to('/follicle-school/aga/') },
          { label: nav.telogen, href: to('/follicle-school/telogen/') },
          { label: nav.areata, href: to('/follicle-school/areata/') },
          { label: nav.quiz, href: to('/follicle-school/quiz/') },
          { label: nav.breastCancer, href: to('/follicle-school/breast-cancer/') },
        ],
      },
    ],
  },
  {
    id: 'aesthetics',
    label: nav.aesthetics,
    href: to('/aesthetics/'),
    children: [{ label: nav.intimate, href: to('/aesthetics/intimate-care/') }],
  },
  {
    id: 'contact',
    label: nav.contact,
    href: to('/contact/'),
    children: [
      { label: nav.bookOnline, href: booking.href, external: true },
      { label: nav.line, href: contact('line'), external: true },
      { label: 'Instagram', href: contact('instagram'), external: true },
      { label: 'Facebook', href: contact('facebook'), external: true },
    ],
  },
];

const drawerItems = [
  ...NAV,
  { label: nav.bookArrow, href: booking.href, external: true, accent: true },
];
---

<header class="site-header">
  <div class="site-header__bar">
    <a class="brand" href={to('/')} aria-label={site.name}>
      <Image src={logo} alt={site.name} height={64} densities={[1, 2, 3]} loading="eager" />
    </a>

    <nav class="nav" aria-label={nav.main}>
      {
        NAV.map((item) => (
          <div class="nav__item">
            <a
              class="nav__link"
              href={item.href}
              aria-current={current === item.id ? 'page' : undefined}
            >
              {item.label}
              <span class="nav__caret" aria-hidden="true">▾</span>
            </a>
            <div class="nav__menu">
              {item.children.map((child) =>
                child.children ? (
                  <div class="nav__branch">
                    <a href={child.href} class="is-branch">
                      {child.label}
                      <span class="nav__branch-caret" aria-hidden="true">›</span>
                    </a>
                    <div class="nav__sub">
                      {child.children.map((leaf) => (
                        <a href={leaf.href}>{leaf.label}</a>
                      ))}
                    </div>
                  </div>
                ) : (
                  <a
                    href={child.href}
                    class:list={[child.lead && 'is-lead']}
                    target={child.external ? '_blank' : undefined}
                    rel={child.external ? 'noopener noreferrer' : undefined}
                  >
                    {child.label}
                  </a>
                ),
              )}
            </div>
          </div>
        ))
      }
      <a class="nav__book" href={booking.href} target="_blank" rel="noopener noreferrer">
        {nav.book}
      </a>
    </nav>

    <LangSwitch />

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label={nav.openMenu}
    >☰</button>
  </div>

  <MobileNav items={drawerItems} current={current} />
</header>
