---
import ImageSlot from './ImageSlot.astro';
import { pageLang, t } from '../i18n/index.js';

const { stages: ui } = t(pageLang(Astro));

const {
  stages,
  slotPrefix,
  scaleName,
  chipMin = 110,
  vertexStageId = null,
  // 每個分型除了插圖，再多放一張臨床照片
  photos = false,
  placeholder = ui.placeholder,
  // 'stage' shows the scale's short id above the label (Norwood I, Ludwig II);
  // 'condition' is a plain titled card, for clinical types with no scale.
  variant = 'stage',
  // Panel artwork is not always the same shape: the staging scales are
  // landscape, the telogen cause diagrams are square.
  imgAspect = '364 / 214',
} = Astro.props;

const isCondition = variant === 'condition';
---

<div class="stage-chips" style={`--chip-min:${chipMin}px;`}>
  {
    stages.map((stage) => (
      <button
        type="button"
        class:list={['stage-chip', isCondition && 'stage-chip--condition']}
        data-stage-toggle={stage.id}
        aria-expanded="false"
        aria-controls={`stage-${stage.id}`}
      >
        {!isCondition && <span class="stage-chip__id">{stage.id}</span>}
        <span class:list={[isCondition ? 'stage-chip__name' : 'stage-chip__title']}>
          {stage.title}
        </span>
      </button>
    ))
  }
</div>

{
  stages.map((stage) => (
    <div
      class:list={['stage-panel', photos && 'stage-panel--stacked']}
      id={`stage-${stage.id}`}
      data-stage-panel={stage.id}
      style={`--stage-img-aspect:${imgAspect};`}
      hidden
    >
      <ImageSlot
        id={`${slotPrefix}${stage.id}`}
        class="stage-panel__img"
        radius={10}
        width={364}
        densities={[1, 2]}
        alt={ui.alt(scaleName, stage.title)}
        placeholder={placeholder}
      />
      <div class="stage-panel__body">
        <p class="stage-panel__title">{stage.title}</p>
        <p class="stage-panel__desc">{stage.desc}</p>
      </div>
      {photos && (
        <ImageSlot
          id={`${slotPrefix}${stage.id}-photo`}
          class="stage-panel__img stage-panel__img--photo"
          radius={10}
          width={364}
          densities={[1, 2]}
          alt={ui.photoAlt(stage.title)}
          placeholder={ui.photoPlaceholder}
        />
      )}
      {vertexStageId === stage.id && (
        <ImageSlot
          id={`${slotPrefix}${stage.id}-vertex`}
          class="stage-panel__img stage-panel__img--vertex"
          radius={10}
          width={364}
          densities={[1, 2]}
          alt={ui.vertexAlt(scaleName, stage.title)}
          placeholder={ui.vertexPlaceholder}
        />
      )}
    </div>
  ))
}
