---
import EvidenceLegend from './EvidenceLegend.astro';
import { Y_TICKS } from '../lib/treatments.js';
import { pageLang, t } from '../i18n/index.js';

const { compare: ui } = t(pageLang(Astro));

// `banners` are the warnings shown above the comparison, in order: the shared
// cost/efficacy disclaimer first, then anything specific to the page.
const { categories, banners = [], tableCategories = [] } = Astro.props;

// Some categories are not a cost-versus-effect trade-off — working out and
// treating the cause has no meaningful price or efficacy tier to plot. Those
// list their treatments in a plain table instead of the quadrant chart.
const asTable = new Set(tableCategories);
---

<div class="compare-head">
  <h2 class="section-title" style="margin:0;" id="treatments">{ui.heading}</h2>
  <button
    type="button"
    class="pill-toggle"
    data-legend-toggle
    aria-expanded="false"
    aria-controls="evidence-legend"
  >{ui.legendToggle}</button>
</div>

{banners.map((text) => <p class="notice notice--warn" style="margin:0 0 16px;">⚠ {text}</p>)}

<EvidenceLegend />

<p class="hint--sm">{ui.expandHint}</p>

<div class="cat-grid">
  {
    categories.map((cat) => (
      <button
        type="button"
        class="cat-card"
        data-cat-toggle={cat.key}
        aria-expanded="false"
        aria-controls={`cat-${cat.key}`}
      >
        <span class="cat-card__top">
          <span class="cat-card__title">{cat.title}</span>
          <span class="cat-card__chevron" aria-hidden="true">⌄</span>
        </span>
        <span class="cat-card__summary">{cat.summary}</span>
      </button>
    ))
  }
</div>

{
  categories.map((cat) => (
    <div class="cat-panel" id={`cat-${cat.key}`} data-cat-panel={cat.key} hidden>
      {cat.warningBanner && <p class="notice notice--warn" style="margin:0;">⚠ {cat.warningBanner}</p>}

      {asTable.has(cat.id) ? (
        <div class="treatment-table-wrap">
          <table class="treatment-table" role="table">
            <thead role="rowgroup">
              <tr role="row">
                <th scope="col" role="columnheader">{ui.treatment}</th>
                <th scope="col" role="columnheader">{ui.sideEffects}</th>
                <th scope="col" role="columnheader">{ui.notes}</th>
              </tr>
            </thead>
            <tbody role="rowgroup">
              {cat.treatments.map((t) => (
                <tr role="row">
                  <th scope="row" role="rowheader" class="treatment-table__name">{t.name}</th>
                  <td role="cell" data-label={ui.sideEffects}>
                    <ul>
                      {t.sideEffects.map((se) => (
                        <li>{se}</li>
                      ))}
                    </ul>
                  </td>
                  <td role="cell" data-label={ui.notes}>
                    <ul>
                      {t.notes.map((note) => (
                        <li>{note}</li>
                      ))}
                    </ul>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
      <div class="quad">
        <p class="quad__caption">{ui.quadCaption}</p>
        <div class="quad__plot">
          {Y_TICKS.map((tick) => (
            <>
              <span class="quad__gridline" style={`bottom:${tick.pct}%;`} aria-hidden="true" />
              <span class="quad__ticklabel" style={`bottom:${tick.pct}%;`} aria-hidden="true">
                {tick.label}
              </span>
            </>
          ))}
          {cat.points.map((point, i) => (
            <span
              class="quad__point"
              data-point={point.id}
              style={`left:${point.x}%;bottom:${point.y}%;--dot-color:${point.color};--label-dy:${point.labelDy}px;`}
            >
              <button
                type="button"
                class="quad__dot"
                data-treatment-toggle={point.id}
                aria-expanded="false"
                aria-controls={`t-${cat.key}-${point.id}`}
              >
                <span class="visually-hidden">{point.name}</span>
                <span class="quad__num" aria-hidden="true">{i + 1}</span>
              </button>
              <button
                type="button"
                class="quad__label"
                data-treatment-toggle={point.id}
                tabindex="-1"
                aria-hidden="true"
              >
                {point.name}
              </button>
            </span>
          ))}
        </div>
        <div class="quad__axis" aria-hidden="true">
          <span>{ui.lowEffect}</span>
          <span>{ui.highEffect}</span>
        </div>
        <ol class="quad__legend" aria-label={ui.listLabel}>
          {cat.points.map((point, i) => (
            <li style={`--dot-color:${point.color};`}>
              <button
                type="button"
                class="quad__legend-item"
                data-treatment-toggle={point.id}
                data-legend-item
                aria-expanded="false"
                aria-controls={`t-${cat.key}-${point.id}`}
              >
                <span class="quad__legend-num" aria-hidden="true">{i + 1}</span>
                <span>{point.name}</span>
              </button>
            </li>
          ))}
        </ol>
      </div>
      )}

      {!asTable.has(cat.id) && cat.treatments.map((t) => (
        <div
          class:list={['treatment', t.warning && 'is-warning']}
          id={`t-${cat.key}-${t.id}`}
          data-treatment-panel={t.id}
          hidden
        >
          <div>
            <p class="treatment__label">{ui.treatment}</p>
            <p class="treatment__name">{t.name}</p>
            <p class="treatment__price">{ui.priceTier(t.priceTier)}</p>
          </div>

          <div>
            <p class="treatment__label">{ui.evidence}</p>
            <span
              class="treatment__evidence"
              style={`background:${t.evidenceBg};color:${t.evidenceFg};`}
            >
              {ui.evidenceGrade(t.evidenceLabel)}
            </span>
          </div>

          <div>
            <p class="treatment__label">{ui.effect}</p>
            <p class="treatment__stars" aria-label={ui.starsLabel(t.stars)}>
              <span aria-hidden="true">{t.starsText}</span>
            </p>
          </div>

          <div>
            <p class="treatment__label">{ui.sideEffects}</p>
            <ul>
              {t.sideEffects.map((se) => (
                <li>{se}</li>
              ))}
            </ul>
          </div>

          <div>
            <p class="treatment__label">{ui.notes}</p>
            <ul>
              {t.notes.map((note) => (
                <li>{note}</li>
              ))}
            </ul>
            {t.warning && (
              <p class="notice notice--danger" style="margin:8px 0 0;">⚠ {t.warningText}</p>
            )}
          </div>

          {t.hideProduct ? (
            <div />
          ) : (
            <div>
              <p class="treatment__label">{ui.product}</p>
              {t.notAvailableTW ? (
                <div class="thumb thumb--unavailable">
                  <span class="thumb__icon" aria-hidden="true">🚫</span>
                  <span>{ui.notInTaiwan}</span>
                </div>
              ) : (
                <button type="button" class="thumb thumb--open" data-lightbox-open={t.id}>
                  <span class="thumb__icon" aria-hidden="true">🔍</span>
                  <span>{t.thumbLabel}</span>
                </button>
              )}
            </div>
          )}
        </div>
      ))}
    </div>
  ))
}
