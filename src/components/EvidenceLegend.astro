---
import { hairContent } from '../lib/hair-content.js';
import { pageLang, t } from '../i18n/index.js';

const lang = pageLang(Astro);
const { EVIDENCE_INFO } = hairContent(lang);
const { compare } = t(lang);

const grades = [
  EVIDENCE_INFO.A,
  EVIDENCE_INFO.Bplus,
  EVIDENCE_INFO.B,
  EVIDENCE_INFO.C,
  EVIDENCE_INFO.D,
  EVIDENCE_INFO.E,
];
---

<div class="evidence-legend" id="evidence-legend" hidden>
  {grades.map((line) => <p>{line}</p>)}
  <p class="is-disclaimer">{EVIDENCE_INFO.disclaimer}</p>
  <p>{compare.starsNote}</p>
</div>
