---
import ImageSlot from './ImageSlot.astro';
import { pageLang, t } from '../i18n/index.js';

const { lightboxes } = Astro.props;
const { lightbox: ui } = t(pageLang(Astro));
const OFF_LABEL = ui.offLabel;
---

<div class="lightbox" id="lightbox" hidden>
  <div class="lightbox__panel" role="dialog" aria-modal="true" aria-label={ui.label} tabindex="-1">
    <button type="button" class="lightbox__close" data-lightbox-close aria-label={ui.close}>✕</button>

    {
      lightboxes.map((lb) => (
        <div class="lightbox__content" data-lightbox-content={lb.id} hidden>
          <p class="lightbox__title">{lb.name}</p>

          {lb.brands ? (
            <>
              <p class="lightbox__hint">{ui.brandsHint}</p>
              <div class="brand-tabs" role="tablist">
                {lb.brands.map((brand, i) => (
                  <button
                    type="button"
                    class:list={['brand-tab', i === 0 && 'is-active']}
                    data-brand-tab={i}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  >
                    {brand.name}
                  </button>
                ))}
              </div>
              {lb.brands.map((brand, i) => (
                <div class="brand-box" data-brand-box={i} hidden={i !== 0}>
                  <p class="brand-box__name">{brand.name}</p>
                  <p class="brand-box__appearance">{brand.appearance}</p>
                  {brand.offLabel && <p class="badge-offlabel">{OFF_LABEL}</p>}
                  <ImageSlot
                    id={`${lb.id}-${i}`}
                    radius={10}
                    alt={ui.brandAlt(brand.name)}
                    placeholder={ui.brandPlaceholder}
                    style="width:100%;height:280px;"
                  />
                </div>
              ))}
              <div class="lightbox__divider" />
            </>
          ) : (
            <ImageSlot
              id={`${lb.id}-photo`}
              radius={12}
              alt={ui.productAlt(lb.name)}
              placeholder={ui.productPlaceholder}
              style={lb.photoStyle ?? 'width:100%;height:280px;margin-bottom:14px;'}
            />
          )}

          {lb.note && <p class="lightbox__note">{lb.note}</p>}
          {lb.offLabelNotice && <p class="badge-offlabel">{lb.offLabelNotice}</p>}
          {lb.typeLabel && (
            <p class="lightbox__type">
              <b>{ui.form}</b>
              {lb.typeLabel}
            </p>
          )}
        </div>
      ))
    }
  </div>
</div>
