---
import { hairContent } from '../lib/hair-content.js';
import { pageLang, t } from '../i18n/index.js';

const lang = pageLang(Astro);
const { AREATA_SEVERITY, AREATA_SEVERITY_ESCALATION } = hairContent(lang);
const { severity } = t(lang);
---

<h3 class="section-subtitle" id="severity">{severity.heading}</h3>
<p class="hint">{severity.hint}</p>

<div class="severity">
  {
    AREATA_SEVERITY.map((s) => (
      <div class="severity__card" data-severity={s.id}>
        <p class="severity__level">{s.level}</p>
        <div class="severity__gauge" aria-hidden="true">
          <span class="severity__fill" style={`width:${s.pct}%;`} />
        </div>
        <p class="severity__range">{s.range}</p>
        <p class="severity__desc">{s.desc}</p>
        <p class="severity__salt">{s.salt}</p>
      </div>
    ))
  }
</div>

<div class="severity__note">
  <p class="severity__note-title">{severity.escalation}</p>
  <ul>
    {AREATA_SEVERITY_ESCALATION.map((item) => <li>{item}</li>)}
  </ul>
</div>
